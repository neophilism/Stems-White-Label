    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "worker:assets": "node --import tsx scripts/asset-worker.ts",
    "test:media-integration": "node --import tsx scripts/validate-media-pipeline.ts",
    "test:queue-integration": "node --import tsx scripts/validate-processing-queue.ts",
    "test:cms-integration": "node --import tsx scripts/validate-catalog-cms.ts",
    "test:licensing-integration": "node --import tsx scripts/validate-licensing.ts",
    "test:checkout-integration": "node --import tsx scripts/validate-checkout-orders.ts",
    "worker:packages": "node --import tsx scripts/download-package-worker.ts",
    "test:delivery-integration": "node --import tsx scripts/validate-secure-delivery.ts",
    "test:package-integration": "node --import tsx scripts/validate-download-package.ts",
    "test:navigation-integration": "node --import tsx scripts/validate-catalog-navigation.ts",
    "test:theme-integration": "node --import tsx scripts/validate-theme-engine.ts",
    "test:domains-integration": "node --import tsx scripts/validate-custom-domains.ts",
    "test:billing-integration": "node --import tsx scripts/validate-saas-billing.ts",
    "test:analytics-integration": "node --import tsx scripts/validate-analytics.ts",
    "test:platform-admin-integration": "node --import tsx scripts/validate-platform-admin.ts",
    "test:team-integration": "node --import tsx scripts/validate-team-accounts.ts",
    "db:demo": "node --import tsx src/lib/demo-seed.ts",
    "test:demo-integration": "node --import tsx scripts/validate-demo-mode.ts",
    "prestart": "npm run db:deploy && npm run db:bootstrap-flagship",
    "db:bootstrap-flagship": "node --import tsx scripts/bootstrap-flagship.ts",
    "test:commerce-integration": "node --import tsx scripts/validate-merchant-accounts.ts",
    "test:payment-integration": "node --import tsx scripts/validate-commerce-payments.ts",
    "commerce:reconcile": "node --import tsx scripts/reconcile-commerce.ts",
    "commerce:expire-tokens": "node --import tsx scripts/expire-checkout-tokens.ts",
    "test:commerce-migration": "node scripts/validate-commerce-migration.mjs",
    "test:http-security": "node scripts/validate-http-security.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1139.0",
    "@aws-sdk/lib-storage": "3.1139.0",
