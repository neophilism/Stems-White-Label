generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantRole {
  OWNER
  ADMIN
  CATALOG_MANAGER
  FINANCE
  VIEWER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum WorkStatus {
  DRAFT
  PROCESSING
  READY
  PUBLISHED
  ARCHIVED
}

enum CollectionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AudioAssetKind {
  MASTER
  STEM
  PREVIEW
  OTHER
}

enum AudioAssetStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum RevealStepAction {
  ADD_SOURCE
  REMOVE_SOURCE
  ALL_SOURCES
  FULL_MIX
  SILENCE
}

enum ProcessingJobType {
  PROCESS_AUDIO
}

enum ProcessingJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ArtworkAssetStatus {
  PENDING
  READY
  FAILED
}

enum LicenseScope {
  WORK
  SELECTED_STEMS
  ALL_STEMS
}

enum OrderStatus {
  PENDING
  CHECKOUT_CREATED
  PAID
  PAYMENT_FAILED
  CANCELED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DownloadPackageStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum ThemePreset {
  UNSEALED
  ATELIER
  ARCHIVE
  MINIMAL
  BRUTALIST
  GALLERY
  CINEMATIC
  CUSTOM
}

enum ThemeTypography {
  EDITORIAL
  CLASSIC
  MODERN
  HUMANIST
  MONO
}

enum ThemeHeroStyle {
  DISPLAY_CASE
  TYPOGRAPHIC
  SPLIT
  IMMERSIVE
  MINIMAL
}

enum ThemeNavStyle {
  BORDERED
  FLOATING
  MINIMAL
}

enum ThemeFooterStyle {
  EDITORIAL
  COMPACT
  MINIMAL
}

enum ThemeDensity {
  AIRY
  BALANCED
  COMPACT
}

enum ThemeAssetKind {
  LOGO
  FAVICON
}

enum ThemeAssetStatus {
  PENDING
  READY
  FAILED
}

enum DomainOwnershipStatus {
  PENDING
  VERIFIED
  FAILED
}

enum DomainRoutingStatus {
  PENDING
  READY
  FAILED
}

enum DomainTlsStatus {
  PENDING
  READY
  FAILED
}

model User {
  id            String             @id @default(cuid())
  name          String?
  email         String?            @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  memberships   TenantMembership[]
  customerProfiles Customer[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tenant {
  id           String             @id @default(cuid())
  name         String
  slug         String             @unique
  status       TenantStatus       @default(ACTIVE)
  isSeed       Boolean            @default(false)
  domains      TenantDomain[]
  memberships  TenantMembership[]
  artists      Artist[]
  collections  Collection[]
  works        Work[]
  audioAssets  AudioAsset[]
  processingJobs ProcessingJob[]
  artworkAssets ArtworkAsset[]
  licenseProducts LicenseProduct[]
  customers       Customer[]
  orders          Order[]
  payments        Payment[]
  purchaseLicenses PurchaseLicense[]
  downloadEntitlements DownloadEntitlement[]
  downloadPackages DownloadPackage[]
  theme           TenantTheme?
  themeAssets     ThemeAsset[]
  commerce        TenantCommerce?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model TenantDomain {
  id                String                @id @default(cuid())
  tenantId          String
  hostname          String                @unique
  isPrimary         Boolean               @default(false)
  verificationToken String?               @unique
  ownershipStatus   DomainOwnershipStatus @default(PENDING)
  routingStatus     DomainRoutingStatus   @default(PENDING)
  tlsStatus         DomainTlsStatus       @default(PENDING)
  verifiedAt        DateTime?
  routingVerifiedAt DateTime?
  tlsVerifiedAt     DateTime?
  claimExpiresAt    DateTime?
  lastCheckedAt     DateTime?
  lastError         String?               @db.Text
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([tenantId])
  @@index([tenantId, ownershipStatus, routingStatus, tlsStatus])
  @@index([claimExpiresAt])
}

model TenantMembership {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      TenantRole @default(VIEWER)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
}

model Artist {
  id           String       @id @default(cuid())
  tenantId     String
  slug         String
  name         String
  displayName  String?
  bio          String?      @db.Text
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryWorks Work[]       @relation("PrimaryArtistWorks")
  credits      WorkCredit[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Collection {
  id          String           @id @default(cuid())
  tenantId    String
  slug        String
  title       String
  description String?          @db.Text
  status      CollectionStatus @default(DRAFT)
  publishedAt DateTime?
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  works       CollectionWork[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

model Work {
  id              String           @id @default(cuid())
  tenantId        String
  primaryArtistId String?
  slug            String
  title           String
  subtitle        String?
  description     String?          @db.Text
  catalogNumber   String?
  bpm             Decimal?         @db.Decimal(6, 2)
  musicalKey      String?
  durationMs      Int?
  status          WorkStatus       @default(DRAFT)
  publishedAt     DateTime?
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryArtist   Artist?          @relation("PrimaryArtistWorks", fields: [primaryArtistId], references: [id], onDelete: SetNull)
  credits         WorkCredit[]
  collections     CollectionWork[]
  stemGroups      StemGroup[]
  audioAssets     AudioAsset[]
  sections        WorkSection[]
  revealSequences RevealSequence[]
  artwork          ArtworkAsset?
  licenseProducts  LicenseProduct[]
  orderItems        OrderItem[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([tenantId, slug])
  @@unique([tenantId, catalogNumber])
  @@index([tenantId, status])
  @@index([primaryArtistId])
}

model WorkSection {
  id        String   @id @default(cuid())
  workId    String
  kind      String
  title     String
  body      String   @db.Text
  position  Int      @default(0)
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workId, position])
}

model WorkCredit {
  id          String   @id @default(cuid())
  workId      String
  artistId    String?
  role        String
  displayName String
  position    Int      @default(0)
  work        Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  artist      Artist?  @relation(fields: [artistId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workId, position])
  @@index([artistId])
}

model CollectionWork {
  collectionId String
  workId       String
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  work         Work       @relation(fields: [workId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([collectionId, workId])
  @@index([collectionId, position])
  @@index([workId])
}

model StemGroup {
  id           String       @id @default(cuid())
  workId       String
  parentId     String?
  slug         String
  label        String
  description  String?      @db.Text
  position     Int          @default(0)
  isFeatured   Boolean      @default(false)
  work         Work         @relation(fields: [workId], references: [id], onDelete: Cascade)
  parent       StemGroup?   @relation("StemGroupHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     StemGroup[]  @relation("StemGroupHierarchy")
  audioAssets  AudioAsset[]
  revealSteps  RevealStep[]
  licenseProducts LicenseProductStem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([workId, slug])
  @@index([workId, position])
  @@index([parentId])
}

model RevealSequence {
  id          String       @id @default(cuid())
  workId      String
  name        String
  description String?      @db.Text
  isPublished Boolean      @default(false)
  position    Int          @default(0)
  work        Work         @relation(fields: [workId], references: [id], onDelete: Cascade)
  steps       RevealStep[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([workId, isPublished, position])
}

model RevealStep {
  id          String           @id @default(cuid())
  sequenceId  String
  stemGroupId String?
  atMs        Int
  action      RevealStepAction
  caption     String?
  sequence    RevealSequence   @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  stemGroup   StemGroup?       @relation(fields: [stemGroupId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([sequenceId, atMs])
  @@index([stemGroupId])
}

model AudioAsset {
  id                 String           @id @default(cuid())
  tenantId           String
  workId             String
  stemGroupId        String?
  sourceAssetId      String?
  kind               AudioAssetKind
  status             AudioAssetStatus @default(PENDING)
  label              String?
  fileName           String
  storageKey         String?
  waveformStorageKey String?
  mimeType           String?
  sizeBytes          BigInt?
  durationMs         Int?
  sampleRateHz       Int?
  bitDepth           Int?
  channels           Int?
  checksumSha256     String?
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  work               Work             @relation(fields: [workId], references: [id], onDelete: Cascade)
  stemGroup          StemGroup?       @relation(fields: [stemGroupId], references: [id], onDelete: SetNull)
  sourceAsset        AudioAsset?      @relation("AudioAssetDerivatives", fields: [sourceAssetId], references: [id], onDelete: Cascade)
  derivatives        AudioAsset[]     @relation("AudioAssetDerivatives")
  processingJobs     ProcessingJob[]
  downloadEntitlements DownloadEntitlement[]
  orderItemAssets OrderItemAsset[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([tenantId, storageKey])
  @@unique([sourceAssetId, kind])
  @@index([tenantId, kind, status])
  @@index([workId])
  @@index([stemGroupId])
  @@index([sourceAssetId])
}

model ProcessingJob {
  id           String              @id @default(cuid())
  tenantId     String
  audioAssetId String
  type         ProcessingJobType   @default(PROCESS_AUDIO)
  status       ProcessingJobStatus @default(QUEUED)
  attempts     Int                 @default(0)
  maxAttempts  Int                 @default(3)
  runAfter     DateTime            @default(now())
  lockedAt     DateTime?
  lockedBy     String?
  startedAt    DateTime?
  completedAt  DateTime?
  lastError    String?             @db.Text
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  audioAsset   AudioAsset          @relation(fields: [audioAssetId], references: [id], onDelete: Cascade)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([audioAssetId, type])
  @@index([status, runAfter, createdAt])
  @@index([tenantId, status])
}


model ArtworkAsset {
  id         String             @id @default(cuid())
  tenantId   String
  workId     String             @unique
  status     ArtworkAssetStatus @default(PENDING)
  fileName   String
  storageKey String?            @unique
  mimeType   String
  sizeBytes  BigInt
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  work       Work               @relation(fields: [workId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([tenantId, status])
}


model LicenseProduct {
  id              String           @id @default(cuid())
  tenantId        String
  workId          String
  slug            String
  name            String
  summary         String?          @db.Text
  scope           LicenseScope     @default(ALL_STEMS)
  isActive        Boolean          @default(true)
  position        Int              @default(0)
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  work            Work             @relation(fields: [workId], references: [id], onDelete: Cascade)
  versions        LicenseVersion[]
  selectedStems   LicenseProductStem[]
  orderItems      OrderItem[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([workId, slug])
  @@index([tenantId, isActive])
  @@index([workId, isActive, position])
}

model LicenseVersion {
  id                    String         @id @default(cuid())
  licenseProductId      String
  version               Int
  priceCents            Int
  currency              String         @default("USD")
  termsText             String         @db.Text
  attributionRequired   Boolean        @default(false)
  commercialUseAllowed  Boolean        @default(true)
  derivativesAllowed    Boolean        @default(true)
  redistributionAllowed Boolean        @default(false)
  seatLimit             Int?
  projectLimit          Int?
  effectiveAt           DateTime       @default(now())
  retiredAt             DateTime?
  licenseProduct        LicenseProduct @relation(fields: [licenseProductId], references: [id], onDelete: Cascade)
  orderItems            OrderItem[]
  purchaseLicenses      PurchaseLicense[]
  createdAt             DateTime       @default(now())

  @@unique([licenseProductId, version])
  @@index([licenseProductId, effectiveAt])
}

model LicenseProductStem {
  licenseProductId String
  stemGroupId      String
  licenseProduct   LicenseProduct @relation(fields: [licenseProductId], references: [id], onDelete: Cascade)
  stemGroup        StemGroup      @relation(fields: [stemGroupId], references: [id], onDelete: Cascade)

  @@id([licenseProductId, stemGroupId])
  @@index([stemGroupId])
}


model Customer {
  id               String   @id @default(cuid())
  tenantId         String
  userId           String?
  email            String
  normalizedEmail  String
  name             String?
  stripeCustomerId String?
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders           Order[]
  purchaseLicenses PurchaseLicense[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, normalizedEmail])
  @@unique([tenantId, stripeCustomerId])
  @@unique([tenantId, userId])
  @@index([tenantId, createdAt])
  @@index([userId])
}

model Order {
  id                      String      @id @default(cuid())
  tenantId                String
  customerId              String?
  status                  OrderStatus @default(PENDING)
  currency                String
  subtotalCents           Int
  totalCents              Int
  buyerEmail              String?
  termsAcceptedAt         DateTime
  stripeCheckoutSessionId String?     @unique
  stripePaymentIntentId   String?     @unique
  stripeConnectedAccountId String?
  platformFeeCents        Int         @default(0)
  paidAt                  DateTime?
  failedAt                DateTime?
  canceledAt              DateTime?
  refundedAt              DateTime?
  tenant                  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer                Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items                   OrderItem[]
  payments                Payment[]
  purchaseLicenses        PurchaseLicense[]
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@index([tenantId, status, createdAt])
  @@index([customerId, createdAt])
}

model OrderItem {
  id                         String         @id @default(cuid())
  orderId                    String
  licenseProductId           String
  licenseVersionId           String
  workId                     String
  licenseNameSnapshot        String
  workTitleSnapshot          String
  licenseVersionNumber       Int
  scopeSnapshot              LicenseScope
  unitPriceCents             Int
  currency                   String
  termsTextSnapshot          String         @db.Text
  attributionRequired        Boolean
  commercialUseAllowed       Boolean
  derivativesAllowed         Boolean
  redistributionAllowed      Boolean
  seatLimit                  Int?
  projectLimit               Int?
  selectedStemLabelsSnapshot Json?
  order                      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  licenseProduct             LicenseProduct @relation(fields: [licenseProductId], references: [id], onDelete: Restrict)
  licenseVersion             LicenseVersion @relation(fields: [licenseVersionId], references: [id], onDelete: Restrict)
  work                       Work            @relation(fields: [workId], references: [id], onDelete: Restrict)
  purchaseLicense            PurchaseLicense?
  deliverableAssets          OrderItemAsset[]
  createdAt                  DateTime        @default(now())

  @@index([orderId])
  @@index([licenseVersionId])
  @@index([workId])
}

model Payment {
  id                String          @id @default(cuid())
  tenantId          String
  orderId           String
  provider          PaymentProvider @default(STRIPE)
  status            PaymentStatus   @default(PENDING)
  providerPaymentId String?
  stripeConnectedAccountId String?
  platformFeeCents  Int             @default(0)
  amountCents       Int
  currency          String
  failureCode       String?
  failureMessage    String?         @db.Text
  refundedCents     Int             @default(0)
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds           Refund[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([provider, providerPaymentId])
  @@index([tenantId, status, createdAt])
  @@index([orderId])
}

model Refund {
  id               String        @id @default(cuid())
  paymentId        String
  providerRefundId String        @unique
  amountCents      Int
  status           PaymentStatus
  reason           String?
  payment          Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([paymentId, createdAt])
}

model PurchaseLicense {
  id               String         @id @default(cuid())
  tenantId         String
  orderId          String
  orderItemId      String         @unique
  customerId       String
  licenseVersionId String
  acceptedAt       DateTime
  termsTextSnapshot String        @db.Text
  revokedAt        DateTime?
  revocationReason String?
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem        OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  licenseVersion   LicenseVersion @relation(fields: [licenseVersionId], references: [id], onDelete: Restrict)
  downloadEntitlements DownloadEntitlement[]
  downloadPackage DownloadPackage?
  createdAt        DateTime       @default(now())

  @@index([tenantId, customerId, createdAt])
  @@index([orderId])
  @@index([licenseVersionId])
}

model PaymentWebhookEvent {
  id              String   @id @default(cuid())
  provider        PaymentProvider
  providerEventId String
  eventType       String
  processedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([processedAt])
}


model DownloadEntitlement {
  id                String          @id @default(cuid())
  tenantId          String
  purchaseLicenseId String
  audioAssetId      String
  fileNameSnapshot  String
  downloadsCount    Int             @default(0)
  lastDownloadedAt  DateTime?
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseLicense   PurchaseLicense @relation(fields: [purchaseLicenseId], references: [id], onDelete: Cascade)
  audioAsset        AudioAsset      @relation(fields: [audioAssetId], references: [id], onDelete: Restrict)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([purchaseLicenseId, audioAssetId])
  @@index([tenantId, createdAt])
  @@index([audioAssetId])
}

model DownloadPackage {
  id                String                @id @default(cuid())
  tenantId          String
  purchaseLicenseId String                @unique
  status            DownloadPackageStatus @default(QUEUED)
  storageKey        String?               @unique
  fileName          String
  sizeBytes         BigInt?
  checksumSha256    String?
  attempts          Int                   @default(0)
  maxAttempts       Int                   @default(3)
  runAfter          DateTime              @default(now())
  lockedAt          DateTime?
  lockedBy          String?
  startedAt         DateTime?
  completedAt       DateTime?
  lastError         String?               @db.Text
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseLicense   PurchaseLicense       @relation(fields: [purchaseLicenseId], references: [id], onDelete: Cascade)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([status, runAfter, createdAt])
  @@index([tenantId, status])
}


model OrderItemAsset {
  orderItemId      String
  audioAssetId     String
  fileNameSnapshot String
  kindSnapshot     AudioAssetKind
  stemLabelSnapshot String?
  orderItem        OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  audioAsset       AudioAsset @relation(fields: [audioAssetId], references: [id], onDelete: Restrict)
  createdAt        DateTime   @default(now())

  @@id([orderItemId, audioAssetId])
  @@index([audioAssetId])
}


model TenantTheme {
  id                String                 @id @default(cuid())
  tenantId          String                 @unique
  preset            ThemePreset            @default(UNSEALED)
  displayTypography ThemeTypography        @default(EDITORIAL)
  bodyTypography    ThemeTypography        @default(MODERN)
  heroStyle         ThemeHeroStyle         @default(DISPLAY_CASE)
  navStyle          ThemeNavStyle          @default(BORDERED)
  footerStyle       ThemeFooterStyle       @default(EDITORIAL)
  density           ThemeDensity           @default(AIRY)
  background        String                 @default("#070706")
  surface           String                 @default("#0e0e0c")
  surfaceRaised     String                 @default("#14130f")
  ink               String                 @default("#f2eee4")
  inkSoft           String                 @default("#cbc4b6")
  muted             String                 @default("#918a7e")
  accent            String                 @default("#b9a16f")
  accentSoft        String                 @default("#766746")
  cornerRadiusPx    Int                    @default(0)
  artworkAspect     String                 @default("1 / 1")
  motionEnabled     Boolean                @default(true)
  logoText          String?
  heroEyebrow       String?
  heroHeadline      String?
  heroSubheadline   String?
  footerStatement   String?                @db.Text
  logoAssetId       String?                @unique
  faviconAssetId    String?                @unique
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logoAsset         ThemeAsset?             @relation("TenantThemeLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)
  faviconAsset      ThemeAsset?             @relation("TenantThemeFavicon", fields: [faviconAssetId], references: [id], onDelete: SetNull)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
}

model ThemeAsset {
  id          String           @id @default(cuid())
  tenantId    String
  kind        ThemeAssetKind
  status      ThemeAssetStatus @default(PENDING)
  fileName    String
  storageKey  String?          @unique
  mimeType    String
  sizeBytes   BigInt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logoFor     TenantTheme?     @relation("TenantThemeLogo")
  faviconFor  TenantTheme?     @relation("TenantThemeFavicon")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([tenantId, kind, status])
}


model TenantCommerce {
  id                              String   @id @default(cuid())
  tenantId                        String   @unique
  stripeAccountId                 String?  @unique
  country                         String?
  defaultCurrency                 String?
  chargesEnabled                  Boolean  @default(false)
  payoutsEnabled                  Boolean  @default(false)
  detailsSubmitted                Boolean  @default(false)
  requirementsCurrentlyDue        Json?
  requirementsEventuallyDue       Json?
  requirementsPastDue             Json?
  requirementsPendingVerification Json?
  disabledReason                  String?
  platformFeeBps                  Int      @default(0)
  accountCreatedAt                DateTime?
  onboardingStartedAt             DateTime?
  onboardingCompletedAt           DateTime?
  lastSyncedAt                    DateTime?
  tenant                          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  @@index([chargesEnabled, payoutsEnabled])
}
