generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantRole {
  OWNER
  ADMIN
  CATALOG_MANAGER
  FINANCE
  VIEWER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum WorkStatus {
  DRAFT
  PROCESSING
  READY
  PUBLISHED
  ARCHIVED
}

enum CollectionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AudioAssetKind {
  MASTER
  STEM
  PREVIEW
  OTHER
}

enum AudioAssetStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum RevealStepAction {
  ADD_SOURCE
  REMOVE_SOURCE
  ALL_SOURCES
  FULL_MIX
  SILENCE
}

model User {
  id            String             @id @default(cuid())
  name          String?
  email         String?            @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  memberships   TenantMembership[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tenant {
  id           String             @id @default(cuid())
  name         String
  slug         String             @unique
  status       TenantStatus       @default(ACTIVE)
  isSeed       Boolean            @default(false)
  domains      TenantDomain[]
  memberships  TenantMembership[]
  artists      Artist[]
  collections  Collection[]
  works        Work[]
  audioAssets  AudioAsset[]
  revealSteps  RevealStep[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model TenantDomain {
  id         String   @id @default(cuid())
  tenantId   String
  hostname   String   @unique
  isPrimary  Boolean  @default(false)
  verifiedAt DateTime?
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
}

model TenantMembership {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      TenantRole @default(VIEWER)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
}

model Artist {
  id           String       @id @default(cuid())
  tenantId     String
  slug         String
  name         String
  displayName  String?
  bio          String?      @db.Text
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryWorks Work[]       @relation("PrimaryArtistWorks")
  credits      WorkCredit[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Collection {
  id          String           @id @default(cuid())
  tenantId    String
  slug        String
  title       String
  description String?          @db.Text
  status      CollectionStatus @default(DRAFT)
  publishedAt DateTime?
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  works       CollectionWork[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

model Work {
  id              String           @id @default(cuid())
  tenantId        String
  primaryArtistId String?
  slug            String
  title           String
  subtitle        String?
  description     String?          @db.Text
  catalogNumber   String?
  bpm             Decimal?         @db.Decimal(6, 2)
  musicalKey      String?
  durationMs      Int?
  status          WorkStatus       @default(DRAFT)
  publishedAt     DateTime?
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryArtist   Artist?          @relation("PrimaryArtistWorks", fields: [primaryArtistId], references: [id], onDelete: SetNull)
  credits         WorkCredit[]
  collections     CollectionWork[]
  stemGroups      StemGroup[]
  audioAssets     AudioAsset[]
  sections        WorkSection[]
  revealSequences RevealSequence[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([tenantId, slug])
  @@unique([tenantId, catalogNumber])
  @@index([tenantId, status])
  @@index([primaryArtistId])
}

model WorkSection {
  id        String   @id @default(cuid())
  workId    String
  kind      String
  title     String
  body      String   @db.Text
  position  Int      @default(0)
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workId, position])
}

model WorkCredit {
  id          String   @id @default(cuid())
  workId      String
  artistId    String?
  role        String
  displayName String
  position    Int      @default(0)
  work        Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  artist      Artist?  @relation(fields: [artistId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workId, position])
  @@index([artistId])
}

model CollectionWork {
  collectionId String
  workId       String
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  work         Work       @relation(fields: [workId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([collectionId, workId])
  @@index([collectionId, position])
  @@index([workId])
}

model StemGroup {
  id           String       @id @default(cuid())
  workId       String
  parentId     String?
  slug         String
  label        String
  description  String?      @db.Text
  position     Int          @default(0)
  isFeatured   Boolean      @default(false)
  work         Work         @relation(fields: [workId], references: [id], onDelete: Cascade)
  parent       StemGroup?   @relation("StemGroupHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     StemGroup[]  @relation("StemGroupHierarchy")
  audioAssets  AudioAsset[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([workId, slug])
  @@index([workId, position])
  @@index([parentId])
}

model RevealSequence {
  id          String       @id @default(cuid())
  workId      String
  name        String
  description String?      @db.Text
  isPublished Boolean      @default(false)
  position    Int          @default(0)
  work        Work         @relation(fields: [workId], references: [id], onDelete: Cascade)
  steps       RevealStep[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([workId, isPublished, position])
}

model RevealStep {
  id          String           @id @default(cuid())
  sequenceId  String
  stemGroupId String?
  atMs        Int
  action      RevealStepAction
  caption     String?
  sequence    RevealSequence   @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  stemGroup   StemGroup?       @relation(fields: [stemGroupId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([sequenceId, atMs])
  @@index([stemGroupId])
}

model AudioAsset {
  id           String           @id @default(cuid())
  tenantId     String
  workId       String
  stemGroupId  String?
  kind         AudioAssetKind
  status       AudioAssetStatus @default(PENDING)
  label        String?
  fileName     String
  storageKey   String?
  mimeType     String?
  sizeBytes    BigInt?
  durationMs   Int?
  sampleRateHz Int?
  bitDepth     Int?
  channels     Int?
  checksumSha256 String?
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  work         Work             @relation(fields: [workId], references: [id], onDelete: Cascade)
  stemGroup    StemGroup?       @relation(fields: [stemGroupId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([tenantId, storageKey])
  @@index([tenantId, kind, status])
  @@index([workId])
  @@index([stemGroupId])
}
